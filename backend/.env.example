GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
POTHOLE_MODEL_URL=https://huggingface.co/peterhdd/pothole-detection-yolov8/resolve/main/best.pt
POTHOLE_CONFIDENCE=0.35
AUTH_SECRET=replace-with-a-long-random-secret
DEVICE_API_KEY=urbanai-bus-device-demo

# Video edge inference tuning
POTHOLE_FRAME_STRIDE=3
POTHOLE_IMGSZ=640
POTHOLE_DEVICE=cpu
POTHOLE_HALF=false
MAX_VIDEO_MB=150
POTHOLE_MAX_VIDEO_SECONDS=0
POTHOLE_TRACK_MAX_GAP_SECONDS=3.0
# Shape refinement: run segmentation only on retained best evidence frames.
# The default SAM checkpoint is general-purpose; for production, replace it with
# a pothole-specific segmentation checkpoint trained on your own labels.
POTHOLE_SEGMENTATION=true
POTHOLE_SEGMENT_MODEL=sam_b.pt
POTHOLE_SEGMENT_MARGIN=0.18

# Low-latency live-video defaults (override per hardware)
# CPU: 416 + stride 2 is a practical prototype balance. CUDA can use stride 1.
POTHOLE_FRAME_STRIDE=2
POTHOLE_IMGSZ=416
POTHOLE_MAX_DET=12
POTHOLE_SEGMENTATION=false
GEMINI_VIDEO_REPORT=true
